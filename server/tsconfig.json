{
  "compilerOptions": {
    /* Base Options */
    "target": "es2016",
    "module": "commonjs",             /* <--- This fixes the import squiggly lines */
    "moduleResolution": "node",
    "rootDir": "./src",
    "outDir": "./dist",
    
    /* Strictness & Types */
    "strict": true,
    "esModuleInterop": true,          /* <--- Allows "import express from 'express'" to work */
    "skipLibCheck": true,             /* <--- Ignores errors in library definition files */
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}